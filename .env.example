# ---- App ----
PROJECT_NAME="FastAPI in Snowflake"
JWT_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32

# ---- First superuser ----
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ---- Snowflake (local dev — password auth) ----
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=fastapi_db
SNOWFLAKE_SCHEMA=fastapi_schema
SNOWFLAKE_WAREHOUSE=fastapi_wh
SNOWFLAKE_ROLE=fastapi_role
SNOWFLAKE_AUTH_TYPE=password
